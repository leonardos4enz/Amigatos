    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@playwright/test": "1.48.2",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "socket.io-client": "4.8.1"
  }
}
